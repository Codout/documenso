# Codout Sign — local docker-compose env.
#
# Copy this file to `.env` (which is gitignored) and fill in the secrets.
# Values left empty here are filled by compose at runtime — don't change.
#
#   cp docker/codout-local/.env.example docker/codout-local/.env
#
# Generate the three secrets locally:
#   openssl rand -hex 32   # NEXTAUTH_SECRET
#   openssl rand -hex 32   # NEXT_PRIVATE_ENCRYPTION_KEY
#   openssl rand -hex 32   # NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY

NEXTAUTH_SECRET=
NEXT_PRIVATE_ENCRYPTION_KEY=
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=

# URLs as the BROWSER sees them (port 3100 is the host-side mapping in
# compose.yml). The container itself listens on 3000 internally.
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3100
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3100

# From-address. Inbucket accepts anything; this is just the visible sender.
NEXT_PRIVATE_SMTP_FROM_NAME=Codout Sign
NEXT_PRIVATE_SMTP_FROM_ADDRESS=noreply@sign.codout.local

# Document signing.
#  - Without these the app starts and lets you click around, but the
#    signing pipeline returns "no certificate available".
#  - To enable: generate or supply a P12, base64-encode it, paste below.
#
#    Linux:  base64 -w0 cert.p12
#    macOS:  base64 -i cert.p12 | tr -d '\n'
NEXT_PRIVATE_SIGNING_TRANSPORT=local
NEXT_PRIVATE_SIGNING_LOCAL_FILE_CONTENTS=
NEXT_PRIVATE_SIGNING_PASSPHRASE=

# Storage. `database` keeps PDFs in Postgres (simplest for local).
# Switch to `s3` and uncomment the MinIO block below to test S3 wiring.
NEXT_PUBLIC_UPLOAD_TRANSPORT=database
# NEXT_PUBLIC_UPLOAD_TRANSPORT=s3
# NEXT_PRIVATE_UPLOAD_ENDPOINT=http://minio:9002
# NEXT_PRIVATE_UPLOAD_FORCE_PATH_STYLE=true
# NEXT_PRIVATE_UPLOAD_REGION=us-east-1
# NEXT_PRIVATE_UPLOAD_BUCKET=codout
# NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=codout
# NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=codoutpassword

# Background jobs. `local` works for everything except scheduled reminders.
NEXT_PRIVATE_JOBS_PROVIDER=local
